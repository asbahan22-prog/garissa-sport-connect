NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Production / Atlas. Leave blank locally to use a persistent embedded MongoDB
# stored in %LOCALAPPDATA%\garissa-sportsconnect\mongo.
MONGO_URI=

# Optional media storage. Without these, images are stored on the API server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to false to skip loading demo data into an empty local database.
AUTO_SEED=true
